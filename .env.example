# CITYSENSE Platform - Environment Configuration Template
# Copy this file to .env and configure your custom settings

# Runtime Environment
CITYSENSE_ENV=development
LOG_LEVEL=INFO

# Open-Meteo Weather Ingestion API
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CITY_NAME=Pune
WEATHER_LATITUDE=18.5204
WEATHER_LONGITUDE=73.8567
WEATHER_TIMEOUT_CONNECT=5.0
WEATHER_TIMEOUT_READ=15.0
WEATHER_MAX_RETRIES=3
WEATHER_BACKOFF_FACTOR=0.5

# Traffic Sensor Simulator Settings
TRAFFIC_NUM_SENSORS=25
TRAFFIC_DEFAULT_SEED=42

# Storage Settings
DATA_BASE_DIR=data
